{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@github/github-mcp-server"],
      "enabled": true,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  },
  "plugin": [
    "opencode-notify",
    ["opencode-mem", { "provider": "sqlite" }],
    "envsitter-guard"
  ],
  "permission": {
    "edit": "ask",
    "bash": { "git *": "allow", "*": "ask" },
    "read": "allow",
    "external_directory": { "*": "allow" }
  }
}
